[Desktop Entry]
Type=Application
Name=Fcitx 5
GenericName=Input Method
Comment=Start the fcitx5 input method
Exec=fcitx5 -d --replace
Icon=fcitx
Terminal=false
Categories=System;Utility;
X-GNOME-Autostart-Phase=Applications
